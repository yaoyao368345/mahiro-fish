# ============================================================================
# mahiro-fish 配置模板
#
# 这个文件只是示例，不要直接改它。
#   - DeepSeek / DSH 相关：复制到 /etc/mahiro-fish/dsh.env
#   - Telegram / ASR / TTS 相关：复制到 ~/.telegram-bridge.env（chmod 600）
#
# 所有值都是占位符。真实密钥只放在服务器本地，永远不要提交到 Git。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. DeepSeek（必需）
# ---------------------------------------------------------------------------
# 在 https://platform.deepseek.com/ 创建 API Key。
DEEPSEEK_API_KEY=sk-REPLACE_ME

# DSH 运行参数（一般不用改）
DSH_TELEMETRY_MODE=DISABLED
DSH_TELEMETRY_DISABLED=1


# ---------------------------------------------------------------------------
# 2. Telegram 私聊桥（强烈建议）
# ---------------------------------------------------------------------------
# 向 @BotFather 发送 /newbot，拿到形如 123456789:AA... 的 Token。
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME

# 你自己的 Telegram 数字 ID。给 @userinfobot 发任意消息即可看到。
# 只有这个 ID 的私聊会被桥接；其他人发消息会被忽略。
OWNER_TELEGRAM_ID=100000000

# 可选：Telegram API 反代 / 本地 Bot API。
# TELEGRAM_API_BASE=https://api.telegram.org

# DSH Web 的本地地址。systemd 模板默认监听 127.0.0.1:3080。
# DSH_BASE_URL=http://127.0.0.1:3080

# 桥等待一轮回复的上限（毫秒）。默认 240000。
# SAY_TIMEOUT_MS=240000


# ---------------------------------------------------------------------------
# 3. 语音识别 ASR（可选，本地）
# ---------------------------------------------------------------------------
# 默认路径与 scripts/install.sh --with-asr 安装的位置一致。
# 不安装就留空；收到语音时会回一句“没听清”，文字聊天不受影响。
# ASR_BIN=/home/fish/.local/sherpa-onnx/sherpa-onnx-v1.13.8-linux-x64-shared-no-tts/bin/sherpa-onnx-offline
# ASR_LIB=/home/fish/.local/sherpa-onnx/sherpa-onnx-v1.13.8-linux-x64-shared-no-tts/lib
# ASR_MODEL=/home/fish/.local/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17/model.int8.onnx
# ASR_TOKENS=/home/fish/.local/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17/tokens.txt
# FFMPEG_BIN=/usr/bin/ffmpeg
# VOICE_MAX_SEC=60
# VOICE_MAX_BYTES=5242880


# ---------------------------------------------------------------------------
# 4. 语音合成 TTS（可选）
# ---------------------------------------------------------------------------
# off           = 只回文字（默认）
# openrouter    = OpenRouter 上的免费 HeyGen 音色（需要 OPENROUTER_API_KEY）
# local         = 本地 Kokoro（需要额外安装，2C4G 上较慢）
# breeze        = Breeze Blue（需要自己的账号与音色 ID；克隆音色属于私人凭据）
TTS_PROVIDER=off
TTS_MAX_CHARS=420

# OpenRouter 免费 TTS
# TTS_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
# OPENROUTER_TTS_VOICE=noelle

# 本地 Kokoro（可选）
# TTS_BIN=/home/fish/.local/sherpa-onnx/sherpa-onnx-v1.13.8-linux-x64-shared/bin/sherpa-onnx-offline-tts
# TTS_LIB=/home/fish/.local/sherpa-onnx/sherpa-onnx-v1.13.8-linux-x64-shared/lib
# TTS_DIR=/home/fish/.local/sherpa-onnx/kokoro-int8-multi-lang-v1_1
# TTS_SID=47

# Breeze Blue（可选，自带音色）
# BREEZE_ENV_FILE=/home/fish/.breezeblue.env
# BREEZE_BASE_URL=https://api.breeze.blue
# BREEZE_TTS_MODEL=breeze-tts-2
# BREEZE_TTS_VOICE=voc_REPLACE_ME
# BREEZE_TTS_SPEED=1.03
# BREEZE_TTS_GUIDANCE=2.0
# BREEZE_TTS_INSTRUCTIONS=用自然、清楚、稍微轻快的年轻女性语气说普通话。


# ---------------------------------------------------------------------------
# 5. 说明
# ---------------------------------------------------------------------------
# - ChatGPT Plus 生图不用写在这里：在 DSH Web 的 设置 → Subscriptions
#   里完成 OAuth 登录即可，令牌保存在 ~/.dsh/plugins/subscriptions/auth.json。
# - B 站 Cookie 也不用写在这里：在 dsh-fish 设置页扫码登录后保存在 owner.json。
# - 这两份文件都属于私人凭据，已在 .gitignore 中排除。
